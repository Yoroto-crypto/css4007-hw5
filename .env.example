# Copy to .env. Part 1 does not need a model or API key.
# Set these for a tool-capable OpenAI model if using the supplied adapter dependency.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Use your own paths; keep persistent data out of git.
HELPDESK_STORAGE_DIR=local-storage
# Keep external tracing disabled for this local exercise.
LANGSMITH_TRACING=false
